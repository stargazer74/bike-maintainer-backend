        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- Generated from the OpenAPI spec (target/generated-sources) – not our code. -->
    <Match>
        <Package name="~de\.chriswohlbrecht\.maintenance\.api(\..*)?"/>
    </Match>
    <Match>
        <Package name="~org\.openapitools(\..*)?"/>
    </Match>

    <!-- Generated by MapStruct. -->
    <Match>
        <Class name="~de\.chriswohlbrecht\.maintenance\.mapper\..*Impl"/>
    </Match>
</FindBugsFilter>
